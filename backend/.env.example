# --- PostgreSQL (async SQLAlchemy via asyncpg) --------------------------------
DATABASE_URL=postgresql+asyncpg://energy:energy@localhost:5432/energy_db
DB_ECHO=false

# --- server -------------------------------------------------------------------
DEBUG=false
CORS_ORIGINS=["*"]

# --- simulator / seeding --------------------------------------------------------
SIMULATOR_ENABLED=true
TICK_SECONDS=2.0
SEED_HISTORY_HOURS=6
SEED_HISTORY_STEP_SECONDS=30
WS_HISTORY_POINTS=90
